{
  "name": "kos-ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:one": "ng test --watch=false --include",
    "lint": "oxlint --config .oxlintrc.json .",
    "lint:fix": "oxlint --config .oxlintrc.json . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev-api": "npx json-server  -p 3001 db.json"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@floating-ui/dom": "^1.7.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-bubble-menu": "^3.23.6",
    "@tiptap/extension-floating-menu": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/lodash": "^4.17.24",
    "lodash": "^4.18.1",
    "ngx-tiptap": "^14.0.1",
    "postcss": "^8.5.15",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.10",
    "@angular/cli": "^20.3.10",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~5.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jasmine-core": "~5.9.0",
    "json-server": "^1.0.0-beta.15",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.68.0"
  }
}
